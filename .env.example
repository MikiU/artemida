# Klucz Service Account (JSON) – wspólny dla wszystkich serwisów.
# Konfiguracja serwisów (property, sitemapy, category_groups) znajduje się
# w pliku sites.yaml.
GOOGLE_CREDENTIALS_PATH=credentials.json

# Alternatywa dla hostingu (Streamlit Cloud): zamiast ścieżki podaj pełny JSON
# klucza w GOOGLE_CREDENTIALS_JSON (przez sekrety, nie w .env commitowanym).
# GOOGLE_CREDENTIALS_JSON={"type":"service_account", ...}
