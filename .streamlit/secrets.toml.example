# Szablon sekretów dla Streamlit Community Cloud.
# Skopiuj do .streamlit/secrets.toml (lokalnie) LUB wklej w panelu:
#   Streamlit Cloud → App → Settings → Secrets
# NIE commituj prawdziwych wartości.

# Pełna treść klucza Service Account (JSON) jako jeden ciąg.
GOOGLE_CREDENTIALS_JSON = '''
{
  "type": "service_account",
  "project_id": "TWOJ_PROJEKT",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "gsc-reader@TWOJ_PROJEKT.iam.gserviceaccount.com",
  "client_id": "...",
  "token_uri": "https://oauth2.googleapis.com/token"
}
'''

